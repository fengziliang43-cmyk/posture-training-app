#!/usr/bin/env bash
set -euo pipefail

umask 077

readonly data_dir="/var/lib/posture-training"
readonly backup_dir="/var/backups/posture-training"
readonly stamp="$(date -u +%Y%m%dT%H%M%SZ)"

install -d -m 0700 "$backup_dir"
work_dir="$(mktemp -d "$backup_dir/.tmp-${stamp}-XXXXXX")"

cleanup() {
  rm -rf -- "$work_dir"
}
trap cleanup EXIT

sqlite3 "$data_dir/app.sqlite" ".timeout 5000" ".backup '$work_dir/app.sqlite'"
test "$(sqlite3 "$work_dir/app.sqlite" "PRAGMA integrity_check;")" = "ok"

tar -C "$data_dir" -czf "$work_dir/uploads.tar.gz" uploads
printf '%s\n' \
  "created_utc=$stamp" \
  "database_integrity=ok" \
  "source=$data_dir" > "$work_dir/manifest.txt"

archive="$backup_dir/posture-${stamp}.tar.gz"
tar -C "$work_dir" -czf "$archive" app.sqlite uploads.tar.gz manifest.txt
sha256sum "$archive" > "$archive.sha256"
chmod 0600 "$archive" "$archive.sha256"

find "$backup_dir" -maxdepth 1 -type f \
  \( -name 'posture-*.tar.gz' -o -name 'posture-*.tar.gz.sha256' \) \
  -mtime +14 -delete
